---
const logoSrc = '/public/logo.png';
---

<header>
  <span class="project-name">Apophysis</span>
  <img src="/logo.png" alt="Mein Logo" class="logo" />
</header>

<style>
  header {
    display: flex;
    height: 60px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    background-color: #fff;
    border-bottom: 1px solid #ddd;
  }

  .project-name {
    font-size: 1.2rem;
    font-weight: bold;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #333;
    padding: 1rem;
  }

  .logo {
    height: 60px;
  }
</style>
